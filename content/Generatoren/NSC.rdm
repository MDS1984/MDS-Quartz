// NSC.rdm
// =================================================================
// Dieser Zufallsgenerator erzeugt, für Keleschitische NSC einen Vor und Nachnamen sowie  eine Rolle, Eigenschaften, ein Ziel, die anfängliche Einstellung des Charakters gegenüber den Spielern sowie ein Gesprächsthema in Bezug auf die aktuelle Quest der Spieler und ein zufällig gewähltes.
// =================================================================

Table: NSC
set: Geschlecht =[|Weiblich|Männlich] 
<b>Name:</b> [when]{$Geschlecht}=Weiblich[do][@Weibliche Vornamen][else][@Männliche Vornamen][end] [@Keleschitische Nachnamen]<br><b>Geschlecht:</b> {$Geschlecht}<br><b>Rolle:</b>[@Charakterrolle]<br><b>Eigenschaften:</b>[@3 Eigenschaft >> implode ,]<br><b>Charakterziel:</b>[@Charakterziel]<br><b>Einstellung:</b> [@Einstellung]<br><b>Gesprächthema mit Bezug zur Quest:</b> [@Questgespräch]<br><b>Zufälliges Gesprächsthema:</b> [@Zufallsgespräch]

